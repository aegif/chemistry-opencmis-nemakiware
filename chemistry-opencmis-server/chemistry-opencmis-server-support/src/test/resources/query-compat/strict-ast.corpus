# CMIS QL Strict AST golden corpus (frozen from ANTLR3-era TestParserStrict expectations)
# format: ok\trule\tinput\texpected_ast
# tabs separate fields; input/expected must not contain raw tabs
ok	order_by_clause	ORDER BY foo	(ORDER_BY (COL foo) ASC)
ok	order_by_clause	ORDER BY foo ASC	(ORDER_BY (COL foo) ASC)
ok	order_by_clause	ORDER BY foo DESC	(ORDER_BY (COL foo) DESC)
ok	order_by_clause	ORDER BY t.foo, bar DESC	(ORDER_BY (COL t foo) ASC (COL bar) DESC)
ok	column_reference	foo	(COL foo)
ok	column_reference	bar.foo	(COL bar foo)
ok	from_clause	FROM foo JOIN bar ON x = y	(FROM (TABLE foo) (JOIN INNER (TABLE bar) (ON (COL x) = (COL y))))
ok	table_join	LEFT OUTER JOIN foo ON x = y	(JOIN LEFT (TABLE foo) (ON (COL x) = (COL y)))
ok	table_join	INNER JOIN foo	(JOIN INNER (TABLE foo))
ok	one_table	foo	(TABLE foo)
ok	one_table	foo bar	(TABLE foo bar)
ok	one_table	foo AS bar	(TABLE foo bar)
ok	one_table	(foo)	(TABLE foo)
ok	in_predicate	foo IN ( 'a', 'b', 'c')	(IN (COL foo) (IN_LIST 'a' 'b' 'c'))
ok	in_predicate	foo NOT IN ( 1, 2, 3)	(NOT_IN (COL foo) (IN_LIST 1 2 3))
ok	quantified_in_predicate	ANY foo IN ('a', 1)	(IN_ANY (COL foo) (IN_LIST 'a' 1))
ok	comparison_predicate	foo = 1	(= (COL foo) 1)
ok	comparison_predicate	foo <> 1	(<> (COL foo) 1)
ok	predicate	foo = 1	(= (COL foo) 1)
ok	predicate	foo IN ('bar')	(IN (COL foo) (IN_LIST 'bar'))
ok	predicate	foo IS NULL	(IS_NULL (COL foo))
ok	predicate	foo IS NOT NULL	(IS_NOT_NULL (COL foo))
ok	predicate	1 = ANY foo	(EQ_ANY 1 (COL foo))
ok	predicate	SCORE() = 'bar'	(= SCORE 'bar')
ok	boolean_term	c >= 3 AND d <= 4	(AND (>= (COL c) 3) (<= (COL d) 4))
ok	boolean_term	c >= 3 AND NOT d <= 4	(AND (>= (COL c) 3) (NOT (<= (COL d) 4)))
ok	folder_predicate	IN_FOLDER(foo,'ID123')	(IN_FOLDER foo 'ID123')
ok	folder_predicate	IN_FOLDER('ID123')	(IN_FOLDER 'ID123')
ok	folder_predicate	IN_TREE(foo,'ID123')	(IN_TREE foo 'ID123')
ok	folder_predicate	IN_TREE('ID123')	(IN_TREE 'ID123')
ok	search_condition	id456 LIKE 'Foo%' AND IN_FOLDER('abc')	(AND (LIKE (COL id456) 'Foo%') (IN_FOLDER 'abc'))
ok	text_search_predicate	CONTAINS('foo')	(CONTAINS 'foo')
ok	text_search_predicate	CONTAINS(bar, 'foo')	(CONTAINS bar 'foo')
ok	where_clause	WHERE foo = 1	(WHERE (= (COL foo) 1))
ok	where_clause	WHERE a = 1 AND b <> 2 OR c >= 3	(WHERE (OR (AND (= (COL a) 1) (<> (COL b) 2)) (>= (COL c) 3)))
ok	where_clause	WHERE a = 1 AND b <> 2 OR c >= 3 AND d <= 4	(WHERE (OR (AND (= (COL a) 1) (<> (COL b) 2)) (AND (>= (COL c) 3) (<= (COL d) 4))))
ok	where_clause	WHERE a = 1 AND b <> 2 OR c >= 3 AND NOT d <= 4	(WHERE (OR (AND (= (COL a) 1) (<> (COL b) 2)) (AND (>= (COL c) 3) (NOT (<= (COL d) 4)))))
ok	query	SELECT * FROM Document	(SELECT * (FROM (TABLE Document)))
ok	query	SELECT a, b, c FROM Document	(SELECT (SEL_LIST (COL a) (COL b) (COL c)) (FROM (TABLE Document)))
ok	query	SELECT a, b FROM Document ORDER BY a, b	(SELECT (SEL_LIST (COL a) (COL b)) (FROM (TABLE Document)) (ORDER_BY (COL a) ASC (COL b) ASC))
ok	where_clause	WHERE IN_TREE('ID00093854763') AND ('SMITH' = ANY AUTHORS)	(WHERE (AND (IN_TREE 'ID00093854763') (EQ_ANY 'SMITH' (COL AUTHORS))))
ok	query	SELECT * FROM Document WHERE foo = 1	(SELECT * (FROM (TABLE Document)) (WHERE (= (COL foo) 1)))
ok	query	SELECT * FROM WHITE_PAPER	(SELECT * (FROM (TABLE WHITE_PAPER)))
ok	query	SELECT TITLE, AUTHORS, DATE FROM WHITE_PAPER WHERE ( IN_TREE('ID00093854763') ) AND ( 'SMITH' = ANY AUTHORS )	(SELECT (SEL_LIST (COL TITLE) (COL AUTHORS) (COL DATE)) (FROM (TABLE WHITE_PAPER)) (WHERE (AND (IN_TREE 'ID00093854763') (EQ_ANY 'SMITH' (COL AUTHORS)))))
ok	query	SELECT Y.CLAIM_NUM, X.PROPERTY_ADDRESS, Y.DAMAGE_ESTIMATES FROM POLICY AS X JOIN CLAIMS AS Y ON X.POLICY_NUM = Y.POLICY_NUM WHERE ( 100000 = ANY Y.DAMAGE_ESTIMATES ) AND ( Y.CAUSE NOT LIKE '%Katrina%' )	(SELECT (SEL_LIST (COL Y CLAIM_NUM) (COL X PROPERTY_ADDRESS) (COL Y DAMAGE_ESTIMATES)) (FROM (TABLE POLICY X) (JOIN INNER (TABLE CLAIMS Y) (ON (COL X POLICY_NUM) = (COL Y POLICY_NUM)))) (WHERE (AND (EQ_ANY 100000 (COL Y DAMAGE_ESTIMATES)) (NOT_LIKE (COL Y CAUSE) '%Katrina%'))))
fail	query	SELECT * TO MyType ORDER BY abc.def ASC
fail	query	SELECT FROM Document
fail	query	SELECT * FROM

# ANTLR3/4 differential parity (nil flatten + keyword casing)
ok	query	SELECT OBJECT_ID, SCORE() AS X, DESTINATION, DEPARTURE_DATES FROM TRAVEL_BROCHURE WHERE ( CONTAINS('CARIBBEAN CENTRAL AMERICA CRUISE TOUR') ) AND( '2010-1-1' = ANY DEPARTURE_DATES )	(SELECT (SEL_LIST (COL OBJECT_ID) SCORE X (COL DESTINATION) (COL DEPARTURE_DATES)) (FROM (TABLE TRAVEL_BROCHURE)) (WHERE (AND (CONTAINS 'CARIBBEAN CENTRAL AMERICA CRUISE TOUR') (EQ_ANY '2010-1-1' (COL DEPARTURE_DATES)))))
ok	query	select * from cmis:document	(select * (from (TABLE cmis:document)))
ok	query	select * from ComplexType where IntProp <= 20	(select * (from (TABLE ComplexType)) (where (<= (COL IntProp) 20)))
ok	query	SELECT BooksAlias.Title AS abc, BooksAlias.Author def FROM BookType AS BooksAlias WHERE ISBN = '100'	(SELECT (SEL_LIST (COL BooksAlias Title) abc (COL BooksAlias Author) def) (FROM (TABLE BookType BooksAlias)) (WHERE (= (COL ISBN) '100')))
ok	query	SELECT BookType.Author, Title TitleAlias FROM BookType WHERE TitleAlias <> 'Harry Potter'	(SELECT (SEL_LIST (COL BookType Author) (COL Title) TitleAlias) (FROM (TABLE BookType)) (WHERE (<> (COL TitleAlias) 'Harry Potter')))
ok	query	SELECT BookType.* FROM BookType WHERE ISBN = '100'	(SELECT (SEL_LIST BookType . *) (FROM (TABLE BookType)) (WHERE (= (COL ISBN) '100')))
ok	query	SELECT BookType.ISBN IsbnAlias FROM BookType WHERE IsbnAlias < '100'	(SELECT (SEL_LIST (COL BookType ISBN) IsbnAlias) (FROM (TABLE BookType)) (WHERE (< (COL IsbnAlias) '100')))
ok	query	SELECT Title AS TitleAlias FROM BookType WHERE Author = 'Jim' ORDER BY TitleAlias	(SELECT (SEL_LIST (COL Title) TitleAlias) (FROM (TABLE BookType)) (ORDER_BY (COL TitleAlias) ASC) (WHERE (= (COL Author) 'Jim')))
ok	query	SELECT Y.ISBN, X.MyBooleanProp, Y.Author FROM (MyDocType AS X JOIN BookType AS Y ON X.MyStringProp = Y.Title) 	(SELECT (SEL_LIST (COL Y ISBN) (COL X MyBooleanProp) (COL Y Author)) (FROM (TABLE MyDocType X) (JOIN INNER (TABLE BookType Y) (ON (COL X MyStringProp) = (COL Y Title)))))
ok	query	SELECT t1.* FROM cmis:document	(SELECT (SEL_LIST t1 . *) (FROM (TABLE cmis:document)))
ok	query	SELECT t2.aaa myalias FROM cmis:document	(SELECT (SEL_LIST (COL t2 aaa) myalias) (FROM (TABLE cmis:document)))
ok	query	SELECT p1, p2, p3.t3 mycol FROM MyType AS MyAlias WHERE p1='abc' and p2=123 ORDER BY abc.def ASC	(SELECT (SEL_LIST (COL p1) (COL p2) (COL p3 t3) mycol) (FROM (TABLE MyType MyAlias)) (ORDER_BY (COL abc def) ASC) (WHERE (and (= (COL p1) 'abc') (= (COL p2) 123))))
ok	query	SELECT p1.T1 MyAlias, p2.T1 AS MyAlias FROM T1	(SELECT (SEL_LIST (COL p1 T1) MyAlias (COL p2 T1) MyAlias) (FROM (TABLE T1)))
ok	query	SELECT DISTINCT a, b, c FROM Document	(SELECT (SEL_LIST (COL DISTINCT) a (COL b) (COL c)) (FROM (TABLE Document)))
ok	query	select foo from bar	(select (SEL_LIST (COL foo)) (from (TABLE bar)))
ok	query	Select Foo From Bar	(Select (SEL_LIST (COL Foo)) (From (TABLE Bar)))
ok	query	sElEcT foo FrOm bar	(sElEcT (SEL_LIST (COL foo)) (FrOm (TABLE bar)))
ok	query	select * from cmis:document where cmis:name = 'x'	(select * (from (TABLE cmis:document)) (where (= (COL cmis:name) 'x')))
ok	query	SELECT SCORE() AS s FROM t	(SELECT (SEL_LIST SCORE s) (FROM (TABLE t)))
ok	query	SELECT DISTINCT f FROM t	(SELECT (SEL_LIST (COL DISTINCT) f) (FROM (TABLE t)))
ok	query	SELECT f AS x FROM t	(SELECT (SEL_LIST (COL f) x) (FROM (TABLE t)))
ok	query	SELECT f x FROM t	(SELECT (SEL_LIST (COL f) x) (FROM (TABLE t)))
